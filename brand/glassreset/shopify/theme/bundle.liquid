<style data-ag-hide-duplicate-quantity>#Quantity-Form-{{ section.id }}{display:none!important}</style><div id="ag-fib-bundle-{{ section.id }}" class="ag-fib-bundle is-live" data-enabled="true" data-initial-variant-id="{{ product.selected_or_first_available_variant.id }}" data-currency="{{ cart.currency.iso_code | default: shop.currency }}" data-variants="{{ product.variants | json | escape }}">
<h2 class="ag-fib-bundle__heading"><span>ΔΙΑΛΕΞΕ ΠΟΣΟΤΗΤΑ</span></h2>
<div class="ag-fib-bundle__choices" role="radiogroup" aria-label="Επιλογή ποσότητας">
<button type="button" class="ag-fib-bundle__card is-selected" role="radio" aria-checked="true" data-qty="1"><span class="ag-fib-bundle__radio" aria-hidden="true"></span><span class="ag-fib-bundle__info"><span class="ag-fib-bundle__label">1 τεμάχιο</span><span class="ag-fib-bundle__sub">Για το αυτοκίνητό σου</span></span><strong class="ag-fib-bundle__total" data-total>—</strong></button>
<button type="button" class="ag-fib-bundle__card" role="radio" aria-checked="false" data-qty="2"><span class="ag-fib-bundle__tag">ΓΙΑ 2 ΑΥΤΟΚΙΝΗΤΑ</span><span class="ag-fib-bundle__radio" aria-hidden="true"></span><span class="ag-fib-bundle__info"><span class="ag-fib-bundle__label">2 τεμάχια <span class="ag-fib-bundle__discount">-13%</span></span><span class="ag-fib-bundle__sub" data-each>—</span></span><strong class="ag-fib-bundle__total" data-total>—</strong></button>
<button type="button" class="ag-fib-bundle__card" role="radio" aria-checked="false" data-qty="3"><span class="ag-fib-bundle__tag">ΚΑΛΥΤΕΡΗ ΤΙΜΗ/ΤΕΜ.</span><span class="ag-fib-bundle__radio" aria-hidden="true"></span><span class="ag-fib-bundle__info"><span class="ag-fib-bundle__label">3 τεμάχια <span class="ag-fib-bundle__discount">-30%</span></span><span class="ag-fib-bundle__sub" data-each>—</span></span><strong class="ag-fib-bundle__total" data-total>—</strong></button>
</div>
<p class="ag-fib-bundle__notice" role="status"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#0A2540"/><path d="M7 12.5l3.2 3.2L17 9" stroke="#fff" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>Η έκπτωση εφαρμόζεται αυτόματα στο καλάθι.</p>
<p class="ag-fib-bundle__variant-note" data-variant-note aria-live="polite"></p>
</div>
<style>
#ag-fib-bundle-{{ section.id }}{--ag-blue:#0A2540;--ag-sky:#E8F7FD;--ag-ink:#1C2833;--ag-line:#D5DEE5;box-sizing:border-box;color:var(--ag-ink);font-family:inherit;margin:1.6rem 0}
#ag-fib-bundle-{{ section.id }} *{box-sizing:border-box}
#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__heading{align-items:center;color:var(--ag-ink);display:flex;font-size:1.45rem;font-weight:700;gap:1rem;letter-spacing:.06em;line-height:1.3;margin:0 0 1.4rem}
#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__heading::before,#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__heading::after{background:var(--ag-blue);content:'';flex:1;height:2px}
#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__heading span{white-space:nowrap}
#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__choices{display:grid;gap:1.3rem}
#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__card{appearance:none;align-items:center;background:#fff;border:2px solid var(--ag-line);border-radius:12px;color:inherit;cursor:pointer;display:grid;font:inherit;gap:1.1rem;grid-template-columns:auto minmax(0,1fr) auto;padding:1.3rem 1.5rem;position:relative;text-align:left;transition:border-color .15s,background-color .15s;width:100%}
#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__card:hover{border-color:#7FA3BD}
#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__card:focus-visible{outline:3px solid rgba(10,61,98,.3);outline-offset:2px}
#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__card.is-selected{background:var(--ag-sky);border-color:var(--ag-blue)}
#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__radio{background:#fff;border:2px solid #8CA3B3;border-radius:50%;display:inline-block;height:2.2rem;position:relative;width:2.2rem}
#ag-fib-bundle-{{ section.id }} .is-selected .ag-fib-bundle__radio{background:var(--ag-blue);border-color:var(--ag-blue)}
#ag-fib-bundle-{{ section.id }} .is-selected .ag-fib-bundle__radio::after{background:#fff;border-radius:50%;content:'';height:.8rem;left:50%;position:absolute;top:50%;transform:translate(-50%,-50%);width:.8rem}
#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__info{display:flex;flex-direction:column;gap:.25rem;min-width:0}
#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__label{align-items:center;color:var(--ag-ink);display:flex;flex-wrap:wrap;font-size:1.65rem;font-weight:700;gap:.6rem;line-height:1.2}
#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__sub{color:#52616D;font-size:1.3rem;line-height:1.35}
#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__discount{background:#19B4E6;border-radius:4px;color:#fff;font-size:1.15rem;font-weight:700;line-height:1;padding:.35rem .5rem}
#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__total{color:var(--ag-ink);font-size:1.7rem;font-weight:700;white-space:nowrap}
#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__tag{background:#0A2540;color:#fff;font-size:1.05rem;font-weight:700;letter-spacing:.04em;line-height:1;padding:.5rem .8rem;position:absolute;right:-.2rem;top:0;transform:translateY(-60%) rotate(-2deg);white-space:nowrap;z-index:1}
#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__notice{align-items:center;color:#52616D;display:flex;font-size:1.25rem;gap:.6rem;line-height:1.45;margin:1.1rem 0 0}
#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__variant-note{color:#52616D;font-size:1.12rem;margin:.4rem 0 0}
#ag-fib-bundle-{{ section.id }} .ag-fib-bundle__variant-note:empty{display:none}
@keyframes agAtcShake{0%,9%,100%{transform:none}1%{transform:translateX(-4px) rotate(-1.5deg)}2.5%{transform:translateX(4px) rotate(1.5deg)}4%{transform:translateX(-4px) rotate(-1.5deg)}5.5%{transform:translateX(3px) rotate(1deg)}7%{transform:translateX(-2px) rotate(-.5deg)}8%{transform:translateX(1px)}}
#ProductSubmitButton-{{ section.id }}{animation:agAtcShake 6s ease-in-out 1.5s infinite;transform-origin:center}
#ProductSubmitButton-{{ section.id }}:hover,#ProductSubmitButton-{{ section.id }}[disabled],#ProductSubmitButton-{{ section.id }}.loading{animation:none}
@media(prefers-reduced-motion:reduce){#ProductSubmitButton-{{ section.id }}{animation:none}}
</style>
<script>
(()=>{
 const root=document.getElementById('ag-fib-bundle-{{ section.id }}');if(!root||root.dataset.initialized==='true')return;root.dataset.initialized='true';
 let variants=[];try{variants=JSON.parse(root.dataset.variants||'[]')}catch{return}if(!variants.length)return;
 const cards=Array.from(root.querySelectorAll('[data-qty]')),fmt=new Intl.NumberFormat('el-GR',{style:'currency',currency:root.dataset.currency||'EUR'});
 const normalise=q=>Math.max(1,Math.floor(Number(q)||1));
 function form(){const scope=root.closest('.product, [id^="MainProduct-"], section');const local=scope?Array.from(scope.querySelectorAll('form[action*="/cart/add"]')):[];const candidates=(local.length?local:Array.from(document.querySelectorAll('form[action*="/cart/add"]'))).filter(f=>!(f.getAttribute('id')||'').includes('installment'));return candidates.find(f=>f.querySelector('[name="add"]')&&f.querySelector('[name="id"]'))||candidates.find(f=>f.querySelector('[name="id"]'))||null}
 function controls(f){return f?Array.from(f.elements).filter(c=>c.name==='quantity'&&(c.tagName==='INPUT'||c.tagName==='SELECT')):[]}
 const set=(c,sel,txt)=>{const e=c.querySelector(sel);if(e)e.textContent=txt};
 function render(q){const f=form(),id=f?.querySelector('select[name="id"],input[name="id"]')?.value||root.dataset.initialVariantId,v=variants.find(x=>String(x.id)===String(id))||variants[0];const qty=normalise(q),tier=qty>=3?3:qty===2?2:1,price=Number(v.price);
 cards.forEach(c=>{const n=Number(c.dataset.qty),off=n>=3?447:n===2?193:0,total=(price-off)*n;c.classList.toggle('is-selected',n===tier);c.setAttribute('aria-checked',String(n===tier));set(c,'[data-total]',fmt.format(total/100));set(c,'[data-each]',fmt.format((price-off)/100)+' το ένα')});
 const note=root.querySelector('[data-variant-note]');if(note&&variants.length>1)note.textContent='Επιλεγμένη έκδοση: '+v.title
 }
 function sync(){render(normalise(controls(form())[0]?.value||1))}
 cards.forEach(c=>c.addEventListener('click',()=>{const q=String(normalise(c.dataset.qty));controls(form()).forEach(x=>{if(x.value===q)return;x.value=q;x.dispatchEvent(new Event('input',{bubbles:true}));x.dispatchEvent(new Event('change',{bubbles:true}))});render(q)}));
 document.addEventListener('input',e=>{if(e.target?.matches('input[name="quantity"],select[name="quantity"]'))sync()},true);
 document.addEventListener('change',e=>{if(e.target?.matches('[name="id"],input[name="quantity"],select[name="quantity"]')||e.target?.closest('form[action*="/cart/add"],variant-selects,variant-radios')){setTimeout(sync,0);setTimeout(sync,500)}},true);
 document.addEventListener('variant:change',()=>setTimeout(sync,0));document.addEventListener('variantChange',()=>setTimeout(sync,0));render(1);
})();
</script>
